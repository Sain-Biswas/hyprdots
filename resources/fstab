# Static information about the filesystems.
# See fstab(5) for details.

# <file system> <dir> <type> <options> <dump> <pass>
# /dev/nvme0n1p7
UUID=<- partition-uuid-{blkid /dev/nvme0n1p7} ->         /         	    btrfs     	rw,relatime,compress=zstd:3,ssd,discard=async,space_cache=v2,subvol=/	0 0

# /dev/nvme0n1p6
UUID=<- partition-uuid-{blkid /dev/nvme0n1p6} ->      	 /boot     	    vfat      	rw,relatime,fmask=0022,dmask=0022,codepage=437,iocharset=ascii,shortname=mixed,utf8,errors=remount-ro	0 2

# /dev/nvme0n1p5
UUID=<- partition-uuid-{blkid /dev/nvme0n1p5} ->         /mnt/shared	ntfs-3g		rw,uid=1000,gid=1000,umask=022,exec,noatime,windows_names	0 0
