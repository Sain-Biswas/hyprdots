/**
 * ░█░█░█▀█░█░█░█▀▄░█▀█░█▀▄░░░░░░░░░█▀▄░█▀█░▀█▀░▀█▀░█▀▀░█▀▄░█░█
 * ░█▄█░█▀█░░█░░█▀▄░█▀█░█▀▄░░░▄▄▄░░░█▀▄░█▀█░░█░░░█░░█▀▀░█▀▄░░█░
 * ░▀░▀░▀░▀░░▀░░▀▀░░▀░▀░▀░▀░░░░░░░░░▀▀░░▀░▀░░▀░░░▀░░▀▀▀░▀░▀░░▀░

 * Refer to, https://github.com/Alexays/Waybar/wiki/Module:-Battery
 */

{
  "battery": {
    "bat": "BAT0", //  The battery to monitor, as in /sys/class/power_supply/ instead of auto detect.
    "interval": 30, //  The polling interval (in seconds) for the battery status.

    //  A number of battery states which get activated on certain capacity levels.
    "states": {
      "warning": 30, //  Add state 'warning' at 30% battery.
      "critical": 15, //  Add state 'critical' at 15% battery.
    },

    "format": "{icon}{capacity}%", //  The format, how the information should be displayed. When the device is discharing.
    "format-full": "󱟢{capacity}%", //  The format, how the information should be displayed. When the battery is full.
    "format-plugged": "󰚥{capacity}%", //  The format, how the information should be displayed. When the device is plugged to power.
    "format-charging": "{icon}{capacity}%", //  The format, how the information should be displayed. When the device is charing.

    "tooltip-format": "Capacity : {capacity}\nHealth   : {health}%\nCycles   : {cycles}", //  The tooltip format. Showed on hover over module.

    //  Based on the current capacity, the corresponding icon gets selected. The order is low to high. Or by the state if it is an object.
    "format-icons": {
      "default": ["󰂎", "󰁺", "󰁻", "󰁼", "󰁽", "󰁾", "󰁿", "󰂀", "󰂁", "󰂂", "󰁹"], //  Icons when device is discharing.
      "charging": ["󰢟", "󰢜", "󰂆", "󰂇", "󰂈", "󰢝", "󰂉", "󰢞", "󰂊", "󰂋", "󰂅"], //  Icons when device is charging.
    },
  },

  /*
   * Upower
   */

  "upower": {
    "icon-size": 22, //  Defines the size of the icons. Set 0 for auto size.
    "hide-if-empty": true, //  Defines visibility of the module if no devices can be found.

    "format": " {percentage}", //  The text format.

    "tooltip": true, //  Option to disable tooltip on hover.
    "tooltip-format": " {time}", //  The tooltip format.

    "tooltip-spacing": 20, //  Defines the spacing between the tooltip device name and device battery status.
  },
}
