/**
 * ░█░█░█▀█░█░█░█▀▄░█▀█░█▀▄░░░░░░░░░█▄█░█▀█░█▀▄░▀█▀░█▀▀
 * ░█▄█░█▀█░░█░░█▀▄░█▀█░█▀▄░░░▄▄▄░░░█░█░█▀▀░█▀▄░░█░░▀▀█
 * ░▀░▀░▀░▀░░▀░░▀▀░░▀░▀░▀░▀░░░░░░░░░▀░▀░▀░░░▀░▀░▀▀▀░▀▀▀

 * Refer to, https://github.com/Alexays/Waybar/wiki/Module:-MPRIS
 */

{
  "mpris": {
    "format": "{player_icon} <span weight='900'>{title}</span> - {artist}", //  The text format.
    "format-paused": "{status_icon} <span weight='900'><i>{title}</i></span> - {artist}", //  The text format to be shown when audio is paused.

    "tooltip-format": "Source -> {player_icon}  {player}\nTitle -> {title}\nArtist -> {artist}\nAlbum -> {album}\nLength -> {position}/{length}\nStatus -> {status_icon}  {status}", //  Format of the default tooltip.

    //  Allows setting {player-icon} based on player-name property.
    "player-icons": {
      "default": "󰎆",
      "mpv": "",
      "firefox": "",
      "youtube": "",
      "vivaldi": "",
      "spotify": "󰓇",
    },

    //  Allows setting {status-icon} based on player status (playing, paused, stopped).
    "status-icons": {
      "paused": "",
      "playing": "",
      "Stopped": "",
    },

    "title-len": 60, //  Maximum length of title to be shown. If title is longer it is truncated with ...
    "interval": 1, //  Duration after which to update the player status.
  },
}
