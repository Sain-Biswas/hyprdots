 */

{
  "power-profiles-daemon": {
    "format": "{icon}", //  Message displayed on the bar. {icon} and {profile} are respectively substituted with the icon representing the active profile and its full name.

    "tooltip": true, //  Display the tooltip.
    "tooltip-format": "Power profile: {profile}\nDriver: {driver}", //  Messaged displayed in the module tooltip. {icon} and {profile} are respectively substituted with the icon representing the active profile and its full name.

    //  Icons used to represent the various power-profile. Note: the default configuration uses the font-awesome icons. You may want to override it if you don't have this font installed on your system.
    "format-icons": {
      "default": "󰂑",
      "performance": "",
      "balanced": "",
      "power-saver": "",
    },
  },
}
