  "hyprland/workspaces": {
    "format": "", //  The format, how information should be displayed.

    //  Based on the workspace name and state, the corresponding icon gets selected.
    "format-icons": {
      "active": "",
      "default": "",
    },

    "on-click": "activate", //  Can be used to activate or close workspaces when clicked on
  },
}
